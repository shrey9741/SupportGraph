# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here

# Cheaper model for routing and specialists (matching model size to task)
ROUTER_MODEL=claude-haiku-5-5
SPECIALIST_MODEL=claude-haiku-5-5

# Guardrail thresholds (tuned on the labeled eval set, see docs/policy.md)
CONFIDENCE_THRESHOLD=0.75
REFUND_AUTO_LIMIT_USD=200
MAX_TOOL_CALLS_PER_TICKET=6

DATABASE_URL=sqlite:///./support_agent.db
