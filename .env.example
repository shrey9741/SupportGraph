# Copy to .env and fill in. Never commit .env.

# "stub" = offline keyword baseline (no API key needed), "groq" = real model
LLM_PROVIDER=stub
# Groq retires models over time. If calls fail with model_not_found, run
# `python scripts/check_llm.py` to list the models your key can use.
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your-key-here

# Guardrail thresholds (tune on the labeled eval set, see docs/policy.md)
CONFIDENCE_THRESHOLD=0.75
REFUND_AUTO_LIMIT_USD=200

# Retries per LLM call (malformed output, rate limits); backoff doubles each try
MAX_LLM_ATTEMPTS=3
