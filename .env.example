# Copy to .env and fill in. Never commit .env.

# "stub" = offline keyword baseline (no API key needed), "groq" = real model
LLM_PROVIDER=stub
# Groq retires models over time. If calls fail with model_not_found, run
# `python scripts/check_llm.py` to list the models your key can use.
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your-key-here

# Guardrail thresholds (tune on the labeled eval set, see docs/policy.md)
CONFIDENCE_THRESHOLD=0.75
REFUND_AUTO_LIMIT_USD=200

# Retries per LLM call (malformed output, rate limits); backoff doubles each try
MAX_LLM_ATTEMPTS=3

# API server: SQLite file for the audit log, and which browser origins may call it
DATABASE_PATH=support_graph.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts. AUTH_REQUIRED=false turns login off (local experiments only; never on a public host).
AUTH_REQUIRED=true
# Signing key for login tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
TOKEN_TTL_HOURS=8
# The first admin is created from these when the database has no users yet.
# Password needs 8+ characters with upper case, lower case and a digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
